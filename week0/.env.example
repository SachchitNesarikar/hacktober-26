# openai = llama.cpp server / llamafile / LM Studio / hosted open-weight API ; ollama = Ollama
BATON_PROVIDER=openai
# llama.cpp: http://127.0.0.1:8080/v1   LM Studio: http://127.0.0.1:1234/v1   Ollama: http://localhost:11434
BATON_BASE_URL=http://127.0.0.1:8080/v1
BATON_MODEL=local-model
# Used by scripts/run.sh and docker compose (Hugging Face repo:quant), downloaded on first start
LLAMA_MODEL=ggml-org/gemma-4-E4B-it-GGUF:Q4_K_M
LLAMA_CTX=8192
# Only for hosted endpoints
BATON_API_KEY=
# Parallel specialist calls in multi-agent mode (use 1 on weak hardware)
BATON_WORKERS=2
BATON_DISABLE_REPO=0
HOST=127.0.0.1
PORT=8765
